{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run build)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun scripts/reading-gates.ts:*)",
      "Bash(bun scripts/fact-ledger.ts:*)",
      "Bash(bun scripts/review-policy.ts:*)",
      "Bash(bun scripts/grounding-pack.ts:*)",
      "Bash(bun scripts/apply-reading.ts:*)",
      "Bash(bun scripts/search-cap.ts:*)",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab mr list:*)",
      "Bash(glab mr view:*)",
      "Bash(glab ci list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge-base:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)"
    ]
  }
}
