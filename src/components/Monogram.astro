---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 80 } = Astro.props;

// Initials: first letter of each name-word, max 2 letters.
// "Alex Komoroske" → "AK"; "Brooks" → "B"; "John Allspaw" → "JA"
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');

const dim = `${size}px`;
const fontSize = `${Math.round(size * 0.42)}px`;
---

<div
  class="monogram"
  style={`width: ${dim}; height: ${dim}; font-size: ${fontSize};`}
  aria-hidden="true"
>
  {initials}
</div>

<style>
  .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-warm);
    color: var(--azul);
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.02em;
    border-radius: 4px;
    flex-shrink: 0;
    line-height: 1;
  }
</style>
