---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const tagline = 'Thinking through the shoulders of giants';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-to-main" href="#main">Skip to content</a>

    <header class="chrome site-chrome">
      <div class="wrap">
        <a href="/" class="site-name">Thinker Distillation</a>
        <p class="tagline">{tagline}</p>
        <nav aria-label="primary" class="chrome-nav">
          <a href="/">Thinkers</a>
          <a href="/concepts/">Concepts</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="chrome">
      <div class="wrap">
        <span>Curated by Julie Davila.</span>
        <a href="/about">About →</a>
      </div>
    </footer>

    <script is:inline>
      // Chrome scroll-collapse — design-spec §3.1 mitigation
      // Hysteresis: collapse above 80px, uncollapse below 40px (prevents
      // flicker oscillation when user lingers near the boundary).
      // Honors prefers-reduced-motion (no transition; class still toggles).
      (() => {
        const chrome = document.querySelector('.site-chrome');
        if (!chrome) return;
        const collapseAt = 80;
        const expandAt = 40;
        let ticking = false;
        let isCollapsed = false;
        const update = () => {
          const y = window.scrollY;
          if (!isCollapsed && y > collapseAt) {
            chrome.classList.add('scrolled');
            isCollapsed = true;
          } else if (isCollapsed && y < expandAt) {
            chrome.classList.remove('scrolled');
            isCollapsed = false;
          }
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
