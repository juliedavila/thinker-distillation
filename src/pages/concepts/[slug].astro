---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { buildConceptHoldersWithAttribution } from '../../lib/graph';
import { runGraphChecks } from '../../lib/checks';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);

await runGraphChecks();

const holdersIndex = await buildConceptHoldersWithAttribution();
const holders = holdersIndex.get(c.slug) ?? [];

const concepts = await getCollection('concepts');
const conceptPagesSet = new Set(concepts.map((cc) => cc.data.slug));
---

<Base title={`${c.display_name} — Thinker Distillation`} description={c.one_line_gloss}>
  <article class="concept-page">
    <header class="concept-hero">
      <p class="concept-eyebrow">Concept</p>
      <h1>{c.display_name}</h1>
      <p class="concept-gloss">{c.one_line_gloss}</p>
    </header>

    {holders.length > 0 && (
      <section aria-labelledby="genealogy">
        <h2 id="genealogy" class="section-h">Genealogy</h2>
        <ol class="genealogy">
          {holders.map((h) => (
            <li class={`genealogy-item kind-${h.attribution_kind}`}>
              <div class="genealogy-head">
                <a href={`/thinkers/${h.thinker_slug}`} class="genealogy-name">
                  {h.name}
                </a>
                <span class="attribution-kind">{h.attribution_kind}</span>
              </div>
              <p class="genealogy-frame">
                <em>{h.frame_display_name}</em> — {h.frame_gloss}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {holders.length > 0 && (
      <section aria-labelledby="holders">
        <h2 id="holders" class="section-h">Who Holds This Frame</h2>
        <div class="holders-grid">
          {holders.map((h) => (
            <div class={`holder-card kind-${h.attribution_kind}`}>
              <p class="holder-name">
                <a href={`/thinkers/${h.thinker_slug}`}>{h.name}</a>
              </p>
              <p class="holder-attribution">{h.attribution_kind}</p>
              <p class="holder-frame-name">{h.frame_display_name}</p>
              {h.source_link && (
                <p class="holder-source">
                  <a href={h.source_link} rel="noopener">primary source →</a>
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="julie-reading">
      <h2 id="julie-reading" class="section-h">Editorial Reading</h2>
      <div class="julie-lane concept-julie">
        <p class="lane-mark">From Julie's reading</p>
        {c.julie_reading ? (
          <div set:html={c.julie_reading.replace(/\n/g, '<br />')} />
        ) : (
          <div class="julie-empty-slot">
            <p class="julie-empty-marker">Awaiting Julie's editorial reading.</p>
            {c.julie_reading_prompt && (
              <details>
                <summary>Prompt scaffold</summary>
                <p class="prompt-text">{c.julie_reading_prompt}</p>
              </details>
            )}
          </div>
        )}
      </div>
    </section>

    {c.limits && c.limits.length > 0 && (
      <section aria-labelledby="breaks">
        <h2 id="breaks" class="section-h">Where This Breaks</h2>
        <div class="julie-lane breaks">
          <p class="lane-mark">Where the frame breaks</p>
          {c.limits.map((limit) => (
            <div class="limit-card">
              <div class="limit-head">
                <span class="headline">{limit.headline}</span>
                <span class={`severity ${limit.severity}`}>{limit.severity}</span>
              </div>
              <p class="elaboration">{limit.elaboration}</p>
            </div>
          ))}
        </div>
        {c.still_load_bearing_despite && (
          <div class="still-load-bearing">
            <p class="lane-mark">Still load-bearing, despite</p>
            <p>{c.still_load_bearing_despite}</p>
          </div>
        )}
      </section>
    )}

    {c.adjacent_concepts && c.adjacent_concepts.length > 0 && (
      <section aria-labelledby="adjacent">
        <h2 id="adjacent" class="section-h">Adjacent Concepts</h2>
        <div class="adjacents">
          {c.adjacent_concepts.map((adj) => {
            const exists = conceptPagesSet.has(adj.target_slug);
            return (
              <div class="adjacent-card">
                <p class="who">
                  {exists ? (
                    <a href={`/concepts/${adj.target_slug}`}>{adj.display_name}</a>
                  ) : (
                    <span class="pending-concept" title="Concept page not yet authored">
                      {adj.display_name}
                    </span>
                  )}
                </p>
                <p class="edge-label">{adj.edge_label}</p>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {c.working_uses && c.working_uses.length > 0 && (
      <section aria-labelledby="working-uses">
        <h2 id="working-uses" class="section-h">Working Uses</h2>
        <div class="julie-lane">
          <p class="lane-mark">Where Julie uses this</p>
          <ul>
            {c.working_uses.map((use) => <li>{use}</li>)}
          </ul>
        </div>
      </section>
    )}

    {c.long_read && (
      <section aria-labelledby="long-read">
        <h2 id="long-read" class="section-h">Long Read</h2>
        <div class="long-read">
          <p class="title">{c.long_read.title}</p>
          <p class="summary">{c.long_read.summary}</p>
        </div>
      </section>
    )}

    {Content && (
      <section aria-labelledby="notes">
        <Content />
      </section>
    )}
  </article>
</Base>
