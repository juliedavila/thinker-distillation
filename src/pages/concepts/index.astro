---
import { href } from '../../lib/href';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const concepts = await getCollection('concepts');
concepts.sort((a, b) => a.data.display_name.localeCompare(b.data.display_name));
---

<Base
  title="Concepts · Thinker Distillation"
  description="Frames that recur across multiple thinkers, with their genealogy, holders, limits and adjacent concepts."
>
  <section class="hero">
    <h1>The concepts</h1>
    <p class="tagline">
      Some frames belong to a single thinker. Others get rediscovered, extended and popularized until they show up in three or four practitioners' work under different names. Concept pages collect those. Each one names a frame, traces who held it and how, marks where it breaks, and links the adjacent concepts that travel with it.
    </p>
  </section>

  <ul class="thinker-index">
    {concepts.map((c) => (
      <li>
        <a href={href(`/concepts/${c.data.slug}`)}>
          <p class="name">{c.data.display_name}</p>
          <p class="tagline">{c.data.one_line_gloss}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>
