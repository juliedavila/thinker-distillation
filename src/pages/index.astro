---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';

const thinkers = await getCollection('thinkers');
thinkers.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base title="Thinker Distillation">
  <section class="hero">
    <h1>The thinkers</h1>
    <p class="tagline">
      Per-practitioner readings of the people whose vocabularies the field now uses to think.
    </p>
  </section>

  <ul class="thinker-index">
    {thinkers.map((t) => (
      <li>
        <a href={`/thinkers/${t.data.slug}`} class="thinker-row">
          <div class="thinker-portrait">
            {t.data.portrait ? (
              <img src={t.data.portrait} alt={`Portrait of ${t.data.name}`} width="80" height="80" />
            ) : (
              <Monogram name={t.data.name} size={80} />
            )}
          </div>
          <div class="thinker-text">
            <p class="name">{t.data.name}</p>
            <p class="tagline">{t.data.tagline}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>
