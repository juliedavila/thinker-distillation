---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/Monogram.astro';
import { buildConceptHoldersIndex, alsoHeldByFor, buildConceptPageIndex } from '../../lib/graph';
import { runGraphChecks, orderNeighbors, daysSince } from '../../lib/checks';

export async function getStaticPaths() {
  const thinkers = await getCollection('thinkers');
  return thinkers.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const t = entry.data;
const { Content } = await render(entry);

await runGraphChecks();
const holdersIndex = await buildConceptHoldersIndex();
const conceptPages = await buildConceptPageIndex();
const pageSlugs = new Set((await getCollection('thinkers')).map((p) => p.data.slug));

const foregroundFrames = t.named_frames.filter((f) => (f.render_tier ?? 'foreground') === 'foreground');
const deepFrames = t.named_frames.filter((f) => f.render_tier === 'deep');
const neighbors = orderNeighbors(t.adjacent_thinkers, pageSlugs);
const hostsEdges = t.adjacent_thinkers.filter((a) => a.edge_type === 'hosts' && a.hosted_items?.length);
const liveEdge = t.live_edge_visible ? t.live_edge : undefined;
const liveEdgeAge = liveEdge ? daysSince(liveEdge.last_observed) : 0;
const STALE_DAYS = 90;
---

<Base title={`${t.name} — Thinker Distillation`} description={t.tagline}>
  <article>
    <section class="hero thinker-hero">
      <div class="thinker-hero-portrait">
        {t.portrait ? (
          <img src={t.portrait} alt={`Portrait of ${t.name}`} width="160" height="160" />
        ) : (
          <Monogram name={t.name} size={160} />
        )}
      </div>
      <div class="thinker-hero-text">
        <h1>{t.name}</h1>
        <p class="tagline">{t.tagline}</p>
        <div class="domain-badges">
          {t.primary_domains.map((d) => <span>{d}</span>)}
        </div>
      </div>
      <p class="thirty-second">{t.thirty_second_take}</p>
    </section>

    <section aria-labelledby="who">
      <h2 id="who" class="section-h">Who They Are</h2>
      <p>{t.background}</p>
      <p>{t.why_they_matter_as_a_thinker}</p>
    </section>

    <section aria-labelledby="pov">
      <h2 id="pov" class="section-h">Core POV</h2>
      <p>{t.thesis}</p>
      {t.working_line && (
        <blockquote class="what-x-says">
          <p>{t.working_line}</p>
          <cite>— {t.name}, paraphrased</cite>
        </blockquote>
      )}
    </section>

    <section aria-labelledby="frames">
      <h2 id="frames" class="section-h">Named Frames</h2>
      {foregroundFrames.map((frame) => {
        const alsoHeld = alsoHeldByFor(frame.concept_slug, t.slug, holdersIndex);
        const hasConceptPage = conceptPages.has(frame.concept_slug);
        return (
          <div class="frame">
            <div class="frame-head">
              <span class="display-name">{frame.display_name}</span>
              <span class="attribution-kind">{frame.attribution_kind}</span>
            </div>
            <p class="gloss">{frame.one_line_gloss}</p>
            {alsoHeld.length > 0 && (
              <p class="also-held">
                <strong>also held by:</strong>{' '}
                {alsoHeld.map((h, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/thinkers/${h.thinker_slug}`}>{h.display_name}</a>{' '}
                    <span class="edge-label">({h.edge_label})</span>
                  </>
                ))}
              </p>
            )}
            {hasConceptPage && (
              <a class="concept-page-link" href={`/concepts/${frame.concept_slug}`}>
                Open concept page →
              </a>
            )}
          </div>
        );
      })}
      {deepFrames.length > 0 && (
        <details class="deep-frames">
          <summary>
            {deepFrames.length} more {deepFrames.length === 1 ? 'frame' : 'frames'} in this thinker's vocabulary
            {t.long_read && <> (see also the <a href={`/thinkers/${t.slug}/long-read`}>long read</a>)</>}
          </summary>
          {deepFrames.map((frame) => (
            <div class="frame deep">
              <div class="frame-head">
                <span class="display-name">{frame.display_name}</span>
                <span class="attribution-kind">{frame.attribution_kind}</span>
              </div>
              <p class="gloss">{frame.one_line_gloss}</p>
            </div>
          ))}
        </details>
      )}
    </section>

    <section aria-labelledby="body-of-work">
      <h2 id="body-of-work" class="section-h">Body of Work</h2>
      <ul class="body-of-work">
        {t.body_of_work.map((item) => (
          <li>
            <div class="title-line">
              {item.link ? <a href={item.link}>{item.title}</a> : item.title}
              <span class="meta">{item.type}{item.year ? ` · ${item.year}` : ''}</span>
              {item.read_first && <span class="tag">read first</span>}
              {item.canonical && <span class="tag">canonical</span>}
            </div>
            {item.editorial_note && <p class="editorial-note">{item.editorial_note}</p>}
          </li>
        ))}
      </ul>
      {hostsEdges.map((edge) => (
        <div class="hosted-work">
          <h3>Hosted by {t.name}, written by {edge.display_name}</h3>
          <ul class="body-of-work">
            {edge.hosted_items!.map((item) => (
              <li>
                <div class="title-line">
                  <a href={item.hosted_on_url}>{item.title}</a>
                  <span class="meta">{item.kind} · {item.year}</span>
                  <span class="tag host-label">hosted, not authored by {t.name}</span>
                </div>
                {item.editorial_framing && <p class="editorial-note">{item.editorial_framing}</p>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section aria-labelledby="editorial">
      <h2 id="editorial" class="section-h">Editorial Reading</h2>
      <div class="julie-lane">
        <p class="lane-mark">The Distillery's reading</p>
        <h3>The reading</h3>
        <p>{t.reading}</p>
        <h3>Where it extends</h3>
        <p>{t.extension}</p>
        {t.margin_note && (
          <>
            <h3>Julie's note</h3>
            <p>{t.margin_note}</p>
          </>
        )}
        {t.working_uses && t.working_uses.length > 0 && (
          <>
            <h3>Working uses</h3>
            <ul>
              {t.working_uses.map((use) => <li>{use}</li>)}
            </ul>
          </>
        )}
      </div>
    </section>

    <section aria-labelledby="breaks">
      <h2 id="breaks" class="section-h">Where This Breaks</h2>
      <div class="julie-lane breaks">
        <p class="lane-mark">Where this breaks</p>
        {t.limits.map((limit) => (
          <div class="limit-card">
            <div class="limit-head">
              <span class="headline">{limit.headline}</span>
              <span class={`severity ${limit.severity}`}>{limit.severity}</span>
            </div>
            <p class="elaboration">{limit.elaboration}</p>
          </div>
        ))}
      </div>
      <div class="still-load-bearing">
        <p class="lane-mark">Still load-bearing, despite</p>
        <p>{t.still_load_bearing_despite}</p>
      </div>
    </section>

    <section aria-labelledby="adjacent">
      <h2 id="adjacent" class="section-h">Adjacent Thinkers</h2>
      <div class="adjacents">
        {neighbors.foreground.map((adj) => (
          <div class="adjacent-card">
            <p class="who">
              {adj.hasPage ? <a href={`/thinkers/${adj.target_slug}`}>{adj.display_name}</a> : adj.display_name}
            </p>
            <div class="edge-tags">
              <span class="edge-tag">{adj.edge_type}</span>
              <span class="edge-tag">{adj.effectiveStrength}</span>
              {adj.hasPage && <span class="edge-tag on-site">on this site</span>}
            </div>
            <p class="edge-label">{adj.edge_label}</p>
          </div>
        ))}
      </div>
      {neighbors.deep.length > 0 && (
        <details class="deep-neighbors">
          <summary>{neighbors.deep.length} more {neighbors.deep.length === 1 ? 'neighbor' : 'neighbors'}</summary>
          <ul>
            {neighbors.deep.map((adj) => (
              <li><strong>{adj.display_name}</strong> ({adj.edge_type}): {adj.edge_label}</li>
            ))}
          </ul>
        </details>
      )}
    </section>

    <section aria-labelledby="further-in">
      <h2 id="further-in" class="section-h">Further In</h2>
      <dl class="further-in">
        <dt>Start here</dt>
        <dd>{t.further_in.start_here}</dd>
        {t.further_in.then_read && t.further_in.then_read.length > 0 && (
          <>
            <dt>Then read</dt>
            <dd>
              <ol>
                {t.further_in.then_read.map((tr) => <li>{tr}</li>)}
              </ol>
            </dd>
          </>
        )}
        {t.further_in.if_you_want_depth && (
          <>
            <dt>If you want depth</dt>
            <dd>{t.further_in.if_you_want_depth}</dd>
          </>
        )}
        {t.further_in.if_you_want_breadth && (
          <>
            <dt>If you want breadth</dt>
            <dd>{t.further_in.if_you_want_breadth}</dd>
          </>
        )}
      </dl>
    </section>

    {liveEdge && (
      <section aria-labelledby="live-edge">
        <h2 id="live-edge" class="section-h">Live Edge</h2>
        <p class:list={['live-edge-meta', { stale: liveEdgeAge > STALE_DAYS }]}>
          Last surveyed {liveEdge.last_observed.toISOString().slice(0, 10)} · {liveEdgeAge} days ago
          {liveEdgeAge > STALE_DAYS && <span class="tag refresh-pending">refresh pending</span>}
        </p>
        <p class="live-edge-focus">{liveEdge.current_focus}</p>
        <p>{liveEdge.summary}</p>
        {liveEdge.recent_work && liveEdge.recent_work.length > 0 && (
          <ul class="live-edge-recent">
            {liveEdge.recent_work.map((w) => (
              <li>
                <em>{w.title}</em> ({w.year}, {w.kind}{w.with ? `, with ${w.with}` : ''}){w.note && <>: {w.note}</>}
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {t.long_read && (
      <section aria-labelledby="long-read">
        <h2 id="long-read" class="section-h">Long Read</h2>
        <div class="long-read">
          <p class="title">{t.long_read.title}</p>
          <p class="summary">{t.long_read.summary}</p>
          <p class="long-read-cta">
            <a href={`/thinkers/${t.slug}/long-read`}>Read the long version →</a>
          </p>
        </div>
      </section>
    )}

    {Content && (
      <section aria-labelledby="notes">
        <Content />
      </section>
    )}
  </article>
</Base>
