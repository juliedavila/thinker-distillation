---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { buildConceptPageIndex } from '../../../../lib/graph';

export async function getStaticPaths() {
  const chapters = await getCollection('longReadChapters');
  const paths = [] as Array<{
    params: { slug: string; chapter: string };
    props: { chapterId: string };
  }>;

  for (const chapter of chapters) {
    const chapterSlug = chapter.id.split('/').pop()?.replace(/\.md$/, '');
    if (!chapterSlug) continue;
    paths.push({
      params: { slug: chapter.data.thinker_slug, chapter: chapterSlug },
      props: { chapterId: chapter.id },
    });
  }

  return paths;
}

const { chapterId } = Astro.props;
const chapter = await getEntry('longReadChapters', chapterId);
if (!chapter) throw new Error(`Chapter not found: ${chapterId}`);

const thinker = await getEntry('thinkers', chapter.data.thinker_slug);
if (!thinker) throw new Error(`Thinker not found: ${chapter.data.thinker_slug}`);

const { Content } = await render(chapter);

const siblings = await getCollection(
  'longReadChapters',
  (c) => c.data.thinker_slug === chapter.data.thinker_slug,
);
siblings.sort((a, b) => a.data.chapter_number - b.data.chapter_number);
const currentIndex = siblings.findIndex((c) => c.id === chapter.id);
const totalChapters = siblings.length;
const chapterOfN = `${String(currentIndex + 1).padStart(2, '0')} of ${String(totalChapters).padStart(2, '0')}`;

const prev = currentIndex > 0 ? siblings[currentIndex - 1] : null;
const next = currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : null;
const prevSlug = prev?.id.split('/').pop()?.replace(/\.md$/, '');
const nextSlug = next?.id.split('/').pop()?.replace(/\.md$/, '');

const conceptPages = await buildConceptPageIndex();
const glossary = chapter.data.glossary ?? [];
const hasGlossary = glossary.length > 0;
---

<Base title={`${chapter.data.title} — ${thinker.data.name}`}>
  <article class="long-read-chapter" data-has-glossary={hasGlossary}>
    <p class="breadcrumb">
      <a href={`/thinkers/${thinker.data.slug}`}>{thinker.data.name}</a>
      <span class="sep">/</span>
      <a href={`/thinkers/${thinker.data.slug}/long-read`}>Long read</a>
      <span class="sep">/</span>
      <span class="chapter-of-n">{chapterOfN}</span>
      <span class="sep">—</span>
      <span class="current">{chapter.data.title}</span>
    </p>

    <h1>{chapter.data.title}</h1>
    {chapter.data.summary && <p class="chapter-summary">{chapter.data.summary}</p>}

    {hasGlossary && (
      <details class="glossary-mobile">
        <summary>Glossary ({glossary.length})</summary>
        <dl class="glossary-list">
          {glossary.map((g) => (
            <>
              <dt>{g.term}</dt>
              <dd>
                {g.gloss}
                {g.concept_slug && conceptPages.has(g.concept_slug) && (
                  <>
                    {' '}<a href={`/concepts/${g.concept_slug}`} class="glossary-link">Concept page →</a>
                  </>
                )}
              </dd>
            </>
          ))}
        </dl>
      </details>
    )}

    <div class="long-read-grid">
      <div class="prose">
        <Content />
      </div>

      {hasGlossary && (
        <aside class="glossary-rail" aria-label="Glossary">
          <h2 class="glossary-head">Glossary</h2>
          <dl class="glossary-list">
            {glossary.map((g) => (
              <>
                <dt>{g.term}</dt>
                <dd>
                  {g.gloss}
                  {g.concept_slug && conceptPages.has(g.concept_slug) && (
                    <>
                      {' '}<a href={`/concepts/${g.concept_slug}`} class="glossary-link">Concept page →</a>
                    </>
                  )}
                </dd>
              </>
            ))}
          </dl>
        </aside>
      )}
    </div>

    <nav class="chapter-nav" aria-label="Chapter navigation">
      {prev && prevSlug ? (
        <a class="prev" href={`/thinkers/${thinker.data.slug}/long-read/${prevSlug}`}>
          <span class="dir">← Previous</span>
          <span class="t">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next && nextSlug ? (
        <a class="next" href={`/thinkers/${thinker.data.slug}/long-read/${nextSlug}`}>
          <span class="dir">Next →</span>
          <span class="t">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</Base>

<style>
  .long-read-chapter {
    max-width: 1080px;
    margin: 0 auto;
  }
  .breadcrumb {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--stone-500);
    margin: 24px 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .breadcrumb a {
    color: var(--stone-500);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--tierra);
    text-decoration: underline;
  }
  .breadcrumb .sep {
    color: var(--stone-300);
  }
  .breadcrumb .chapter-of-n {
    color: var(--azul);
  }
  .breadcrumb .current {
    color: var(--ink);
  }
  .long-read-chapter h1 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.2rem, 4.5vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 12px;
    max-width: 22ch;
  }
  .chapter-summary {
    font-family: var(--body);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--stone-700);
    max-width: 56ch;
    margin: 0 0 36px;
    border-left: 3px solid var(--oro);
    padding-left: 16px;
  }
  .long-read-grid {
    display: grid;
    grid-template-columns: minmax(0, 62ch) minmax(0, 280px);
    gap: 56px;
    align-items: start;
  }
  .long-read-chapter[data-has-glossary="false"] .long-read-grid {
    grid-template-columns: minmax(0, 62ch);
  }
  .prose {
    font-family: var(--body);
    font-size: 1rem;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.4rem;
    color: var(--azul);
    letter-spacing: 0;
    margin: 48px 0 16px;
    padding-bottom: 0;
    border-bottom: 0;
    text-transform: none;
  }
  .prose :global(h3) {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--ink);
    margin: 32px 0 12px;
  }
  .prose :global(p) {
    max-width: 62ch;
    margin: 0 0 18px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--tierra);
    padding-left: 18px;
    margin: 24px 0;
    font-style: italic;
    color: var(--stone-700);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--paper-warm);
    padding: 1px 6px;
    border-radius: 2px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--stone-300);
    margin: 48px 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }

  /* ─── Glossary rail (desktop) ─────────────────────────────────────── */
  .glossary-rail {
    position: sticky;
    top: 32px;
    padding: 20px 22px;
    background: var(--paper-warm);
    border-left: 3px solid var(--oro);
    border-radius: 2px;
    font-family: var(--body);
  }
  .glossary-head {
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--azul);
    margin: 0 0 12px;
  }
  .glossary-list {
    margin: 0;
  }
  .glossary-list dt {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--ink);
    margin-top: 12px;
  }
  .glossary-list dt:first-child {
    margin-top: 0;
  }
  .glossary-list dd {
    font-family: var(--body);
    font-size: 0.92rem;
    color: var(--stone-700);
    margin: 4px 0 0;
    line-height: 1.5;
  }
  .glossary-link {
    color: var(--azul);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    white-space: nowrap;
  }

  /* ─── Glossary as <details> on mobile only ────────────────────────── */
  .glossary-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .long-read-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .glossary-rail {
      display: none;
    }
    .glossary-mobile {
      display: block;
      margin: 0 0 32px;
      padding: 14px 18px;
      background: var(--paper-warm);
      border-left: 3px solid var(--oro);
      border-radius: 2px;
    }
    .glossary-mobile summary {
      cursor: pointer;
      font-family: var(--display);
      font-weight: 500;
      color: var(--azul);
    }
    .glossary-mobile[open] summary {
      margin-bottom: 12px;
    }
  }

  /* ─── Chapter nav (preserved, palette-aware) ──────────────────────── */
  .chapter-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 64px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--stone-300);
  }
  .chapter-nav a {
    display: block;
    font-family: var(--body);
    color: var(--ink);
    text-decoration: none;
    max-width: 45%;
  }
  .chapter-nav .next {
    text-align: right;
  }
  .chapter-nav .dir {
    display: block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--stone-500);
    margin-bottom: 4px;
  }
  .chapter-nav .t {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1rem;
  }
</style>
